# Academic Paper Pipeline — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Anthropic API key (for paper triage scoring)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Zotero API key (for promoting papers to your library)
# Create one at: https://www.zotero.org/settings/keys
# Enable read/write access to your personal library
ZOTERO_API_KEY=

# Your Zotero library ID (the number in your profile URL)
# Find it at: https://www.zotero.org/settings/keys — listed as "Your userID"
ZOTERO_LIBRARY_ID=

# Library type: "user" for personal library, "group" for shared
ZOTERO_LIBRARY_TYPE=user

# Your email for OpenAlex polite pool (faster API access, no key needed)
# Just use your institutional email
OPENALEX_EMAIL=

# Google Sheet CSV URL (for ingesting Scholar/SSRN alert emails)
# Set up the Google Apps Script (see google_apps_script.js), then:
# File → Share → Publish to web → Sheet1 → CSV → Publish → paste URL here
GSHEET_CSV_URL=
