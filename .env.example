# Copy to .env for local runs. On GitHub Actions the Anthropic credential comes from Workload Identity
# Federation (see .github/workflows/digest.yml); the rest come from repository secrets/variables.
ANTHROPIC_API_KEY=            # local only; a short-lived key is enough for tuning runs
CROSSREF_MAILTO=you@example.edu
GSHEET_CSV_URL=
# optional
S2_API_KEY=
